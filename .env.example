# --- Server ---
PORT=8787
HOST=0.0.0.0
DB_PATH=./data/losslesscloud.db

# --- Indexers (Prowlarr / Jackett Torznab). Comma-separate for several; keys align by position. ---
# Prowlarr: http://prowlarr:9696/<indexerId>/api   Jackett: http://jackett:9117/api/v2.0/indexers/all/results/torznab/api
TORZNAB_URL=
TORZNAB_API_KEY=
TORZNAB_CATEGORIES=3040

# --- TorBox ---
# Fallback key when the client does not pass ?torboxKey=. Also used by the indexer to read
# file lists of magnet-only releases via checkcached.
TORBOX_API_KEY=
TORBOX_BASE_URL=https://api.torbox.app/v1/api

# --- Background feeds (RSS or JSON), comma-separated; polled every FEED_POLL_MINUTES ---
FEED_URLS=
FEED_POLL_MINUTES=30

# --- Behaviour ---
SEARCH_TTL_HOURS=12
ONDEMAND_TIMEOUT_MS=8000
# Resolve: allow a title+artist match when the indexed track has no known duration (not strict)
MATCH_ALLOW_UNKNOWN_DURATION=false
MATCH_DURATION_TOLERANCE_SEC=3
