{
  "name": "losslesscloud",
  "version": "1.0.0",
  "description": "Eclipse Music / BitChord addon: lossless FLAC indexer + TorBox streaming",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
